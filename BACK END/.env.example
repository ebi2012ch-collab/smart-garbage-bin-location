# ─────────────────────────────────────────────────────────────
#  SmartBin Adama City — Environment Variables
#  Copy this file to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (change to a long random string in production)
JWT_SECRET=smartbin_adama_super_secret_key_change_me
JWT_EXPIRES_IN=8h

# Admin credentials (used for the first-time seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS — empty means allow ALL origins (fine for development)
CORS_ORIGINS=

# Upload folder (relative to BACK END/)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Monitoring defaults
BIN_FILLING_THRESHOLD=70
BIN_COLLECTION_THRESHOLD=90
BIN_READING_STALE_MINUTES=120

# Set a unique high-entropy value before connecting physical sensors.
# The sensor endpoint rejects requests while this is empty.
DEVICE_KEY=

# ── Multi-Bin Software Simulator (node db/simulateAllBins.js) ──
# URL the simulator posts readings to (defaults to http://localhost:PORT/api)
# SIMULATOR_API_URL=http://localhost:3000/api

# How many % to add per tick (default 5)
# SIM_FILL_STEP=5

# Ms between sensor readings while filling (default 8000)
# SIM_SENSOR_INTERVAL=8000

# Ms between state polls when a bin is FULL (default 6000)
# SIM_POLL_INTERVAL=6000

# Ms of startup delay between each bin (default 1500)
# SIM_STAGGER_MS=1500
